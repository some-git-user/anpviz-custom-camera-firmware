#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# cam -- get a camera address, asking if it was not supplied.
#
#   ./tools/cam 192.0.2.11   -> echoed straight back
#   ./tools/cam                     -> prompts:  camera IP: _
#
# For non-interactive use (cron, Nagios, CI) set CAM_IP=1.2.3.4 so nothing
# blocks waiting on a terminal.
#
# Other scripts source this for the function:
#
#   . "$(dirname "$0")/cam"
#   HOST="$(cam_host "${1:-}" "camera IP")" || exit 1
#
# The prompt goes to stderr so stdout stays cleanly pipeable.
# ---------------------------------------------------------------------------
set -u

# An IPv4 dotted quad, or a plain hostname.
is_host() {
    printf '%s' "$1" | grep -Eq '^([0-9]{1,3}(\.[0-9]{1,3}){3}|[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+)$'
}

# cam_host [address] [prompt-text]
cam_host() {
    local arg="${1:-${CAM_IP:-}}" prompt="${2:-camera IP}" reply

    if [ -z "$arg" ]; then
        if [ ! -t 0 ]; then
            echo "cam: no camera address given." >&2
            echo "     pass it as an argument, or set CAM_IP=1.2.3.4" >&2
            return 1
        fi
        printf '%s: ' "$prompt" >&2
        IFS= read -r reply || { echo "cam: no address entered." >&2; return 1; }
        arg="${reply//[[:space:]]/}"
    fi

    if [ -z "$arg" ]; then
        echo "cam: no camera address given." >&2
        return 1
    fi
    if ! is_host "$arg"; then
        echo "cam: '$arg' is not an IPv4 address or hostname." >&2
        return 1
    fi
    printf '%s\n' "$arg"
}

# Run directly (not sourced)?
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    cam_host "${1:-}" "${2:-camera IP}" || exit 1
fi
