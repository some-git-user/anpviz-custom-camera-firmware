#!/bin/sh
# udhcpc to get ntp config

export FOUND_GOOGLE_DNS=0
RESOLV_CONF="/tmp/resolv.conf"
export FILENAME_RESULT=/tmp/dhcp.result.$interface
export FILENAME_RENEW_FLAG=/tmp/$interface.dhcp.renew.flag

[ -n "$1" ] || { echo "Error: should be called from udhcpc"; exit 1; }

NETMASK=""
[ -n "$subnet" ] && NETMASK="netmask $subnet"
BROADCAST="broadcast +"
[ -n "$broadcast" ] && BROADCAST="broadcast $broadcast"

case "$1" in
	renew|bound)
		if [ -n "$ntpsrv" ] ; then
			echo "$ntpsrv" > /mnt/nand/ntpmsg
		fi
esac

exit 0
