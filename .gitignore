# ---------------------------------------------------------------------------
# ANJOY888 / MCF46D custom firmware workspace -- git ignore rules
#
# Philosophy: track SOURCE (the editable rootfs tree, tools, scripts, docs).
# Ignore everything reproducible (packed .bin images, squashfs, scratch
# extraction copies) and all private key material.
# ---------------------------------------------------------------------------

# --- Packed firmware images (reproducible via ./pack.sh) ---
*.bin
!tools/**/*.bin

# --- Squashfs images (reproducible via mksquashfs / pack.sh) ---
*.squashfs

# --- Scratch extraction / verification copies (regenerated by extract.sh) ---
# Only work/build/rootfs is the tracked working tree; the rest are throwaway.
work/rootfs/
work/orig/
work/repack/
work/v2check/
work/v343/
work/vcheck/
work/verify/
work/verify_final/
work/new/
# header.bin / tail.bin are extracted artifacts (regenerated by extract.sh)
work/header.bin
work/tail.bin

# --- Private TLS key material (NEVER commit) ---
# The cert/key/passphrase are generated at repack time by pack.sh.
https.key
https.pwd
https.crt
*.key
*.pwd
*.pem
opt/ch/https.key
opt/ch/https.pwd
work/build/rootfs/opt/ch/https.key
work/build/rootfs/opt/ch/https.pwd
# generated certs (regenerated each repack)
work/build/rootfs/opt/ch/https.crt

# --- Recovery telnet password (generated by pack.sh, NEVER commit) ---
reclogin.pass
work/build/rootfs/opt/ch/reclogin.pass
tools/.reclogin.pass
tools/.reclogin_pass

# --- Editor / OS cruft ---
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc

# --- Local scratch ---
/tmp/
*.log
