#!/bin/sh

source /etc/profile 

export PATH=/config:/sbin:/bin:/opt/ch:/tmp/oem/app
export LD_LIBRARY_PATH="/mnt/app/app:/tmp/app/app:/mnt/app/app:/tmp/oem/app:/tmp:/lib:/usr/lib:/ext/lib:/usr/local/lib:/system/lib:/opt/ch:$LD_LIBRARY_PATH"


mount -t sysfs none /sys
mount -t tmpfs mdev /dev

mount -t debugfs none /sys/kernel/debug/
mkdir -p /dev/pts
mkdir -p /dev/bus/usb
mount -t devpts devpts /dev/pts
mdev -s
chip=`cat /sys/devices/soc0/machine | busybox awk '{print $2}'`
echo "$chip"

mount -a
mkdir -p /dev/shm
mkdir -p /dev/pts
mount devpts

echo /sbin/mdev > /proc/sys/kernel/hotplug

/sbin/mdev -s




mkdir -p /tmp/network
umount -fl /mnt/usb


ifconfig lo up
ifconfig lo 127.0.0.1

#ifconfig eth0 up
#udhcpc &

/opt/ch/loadko

cd /opt/ch/

./procman &

# --- HARDWARE DIAGNOSTICS COLLECTOR (added by custom build) -----------------
# Keeps /tmp/hwinfo.txt fresh for the web UI "version" page (served at
# /hwinfo.txt via a symlink -- the web_server has no .json content-type).
# Refreshes every 5s. Remove this block + the symlink + hwinfo.sh to revert.
(
	# let the kernel/proc settle a moment before first sample
	sleep 2
	/opt/ch/hwinfo.sh loop 5
) &
# --------------------------------------------------------------------------

#telnetd &

cp /etc/passwd_sys /tmp/passwd
sysctl -p

# --- RECOVERY SHELL (added by custom build) -------------------------------
# Telnet is now WEB-CONTROLLED. The daemon /opt/ch/telnetd_ctl.sh polls the
# persisted config field <StreamAccess enable_tst="N"> in /mnt/nand/config.xml
# and starts/stops telnetd accordingly (default: DISABLED).
#   Enable:  Configuration -> Network -> Port -> Telnet -> Confirm
#   Login:   root  /  (recovery password printed by ./pack.sh, stored in
#            /opt/ch/reclogin.pass -- not kept in git)
# Login uses our OWN login program instead of /bin/login because the vendor
# mainctrl overwrites the root password at boot (it runs
#   echo -e "<pw>\n<pw>" | passwd root
# when /opt/ch/flag.set.passwd exists), which would lock out any password we
# bake into /etc/passwd. The wrapper checks a fixed credential itself, so it
# is immune to that.
# To force telnet ON at boot regardless of config: `touch /tmp/telnet.force`
# (or set enable_tst="1"). To restore stock behaviour: use "telnetd &".
#
# NOTE: invoked via `sh` and tested with `-f` (not `-x`) on purpose. An earlier
# build used `[ -x ... ]` + direct exec; the file shipped without the exec bit,
# the test failed, and the fallback below left telnet OPEN UNCONDITIONALLY --
# i.e. the web toggle silently did nothing. `sh script` never needs the exec bit.
# The block is also FAIL-CLOSED: if the daemon is missing, telnet stays off.
echo "RECOVERY: starting web-controlled telnetd daemon" > /dev/console
if [ -f /opt/ch/telnetd_ctl.sh ]; then
        ( sh /opt/ch/telnetd_ctl.sh 5 >/tmp/telnetd_ctl.log 2>&1 & )
fi
